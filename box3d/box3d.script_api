- name: box3d
  type: table
  desc: Low-level Box3D 3D physics API for Defold.
  members:
  - name: BODY_TYPE_STATIC
    type: number
    desc: Static body type.
  - name: BODY_TYPE_KINEMATIC
    type: number
    desc: Kinematic body type.
  - name: BODY_TYPE_DYNAMIC
    type: number
    desc: Dynamic body type.
  - name: get_version
    type: function
    desc: Returns Box3D version fields and the pinned upstream commit.
    returns:
    - name: version
      type: table
      desc: Version information.
  - name: create_world
    type: function
    desc: Creates an independent Box3D world. The world is also destroyed by garbage collection.
    parameters:
    - name: options
      type: table
      desc: Optional world definition.
      optional: true
    returns:
    - name: world
      type: userdata
      desc: World handle.
  - name: destroy_world
    type: function
    desc: Destroys a world and every body and shape it owns.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
  - name: step
    type: function
    desc: Advances a world simulation.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
    - name: dt
      type: number
      desc: Time step in seconds.
    - name: substeps
      type: number
      desc: Solver substep count, defaults to 4.
      optional: true
  - name: create_body
    type: function
    desc: Creates a body from a definition table.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
    - name: definition
      type: table
      desc: Body definition.
    returns:
    - name: body
      type: userdata
      desc: Body handle.
  - name: destroy_body
    type: function
    desc: Destroys a body and its shapes.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
  - name: create_box
    type: function
    desc: Attaches a box hull to a body.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: definition
      type: table
      desc: Shape definition including half_extents.
    returns:
    - name: shape
      type: userdata
      desc: Shape handle.
  - name: create_sphere
    type: function
    desc: Attaches a sphere to a body.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: definition
      type: table
      desc: Shape definition including radius.
    returns:
    - name: shape
      type: userdata
      desc: Shape handle.
  - name: create_capsule
    type: function
    desc: Attaches a capsule to a body.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: definition
      type: table
      desc: Shape definition including center1, center2, and radius.
    returns:
    - name: shape
      type: userdata
      desc: Shape handle.
  - name: create_cylinder
    type: function
    desc: Attaches a tessellated cylinder hull to a body.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: definition
      type: table
      desc: Shape definition including height and radius.
    returns:
    - name: shape
      type: userdata
      desc: Shape handle.
  - name: get_transform
    type: function
    desc: Gets body position and rotation.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    returns:
    - name: position
      type: vector3
      desc: World position.
    - name: rotation
      type: quaternion
      desc: World rotation.
  - name: set_transform
    type: function
    desc: Teleports a body to a world transform.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: position
      type: vector3
      desc: World position.
    - name: rotation
      type: quaternion
      desc: World rotation.
  - name: apply_force
    type: function
    desc: Applies a world-space force at a point.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: force
      type: vector3
      desc: Force vector.
    - name: point
      type: vector3
      desc: World-space application point.
    - name: wake
      type: boolean
      desc: Whether to wake the body, defaults to true.
      optional: true
  - name: apply_linear_impulse
    type: function
    desc: Applies an instantaneous impulse at a point.
    parameters:
    - name: body
      type: userdata
      desc: Body handle.
    - name: impulse
      type: vector3
      desc: Impulse vector.
    - name: point
      type: vector3
      desc: World-space application point.
    - name: wake
      type: boolean
      desc: Whether to wake the body, defaults to true.
      optional: true
  - name: explode
    type: function
    desc: Calls Box3D's geometry-aware radial explosion operation.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
    - name: definition
      type: table
      desc: Explosion definition.
  - name: get_body_events
    type: function
    desc: Returns body movement events from the most recent step.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
    returns:
    - name: events
      type: table
      desc: Array of move events.
  - name: get_sensor_events
    type: function
    desc: Returns sensor begin and end events from the most recent step.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
    returns:
    - name: events
      type: table
      desc: Event arrays.
  - name: get_contact_events
    type: function
    desc: Returns contact begin, end, and hit events from the most recent step.
    parameters:
    - name: world
      type: userdata
      desc: World handle.
    returns:
    - name: events
      type: table
      desc: Event arrays.
